# Polymarket (required for trading, optional for reading market data)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=

# Telegram (optional - for news feed from Telegram channels)
# Get credentials from https://my.telegram.org/auth
# Then run: python3 scripts/telegram_setup.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Firecrawl (optional - for scraping news sites)
# Get key from https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# News RSS feeds (comma-separated, defaults provided)
NEWS_RSS_FEEDS=

# Trading config
MAX_BET_SIZE_USD=10
MIN_CONFIDENCE=0.6
KELLY_FRACTION=0.5
